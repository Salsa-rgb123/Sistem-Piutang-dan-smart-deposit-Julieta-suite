:root{--ink:#18232b;--muted:#718087;--line:#e6ece8;--paper:#f7faf8;--white:#fff;--teal:#146b66;--teal-dark:#0e514d;--mint:#dff2e9;--orange:#e88b4d;--rose:#f8e4df;--yellow:#fff3d8;--shadow:0 16px 40px rgba(24,55,47,.06)}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif}button,input,select{font:inherit}button{cursor:pointer;border:0}.app-shell{display:flex;min-height:100vh}.sidebar{width:254px;background:#123f3d;color:#dbece6;padding:28px 18px;display:flex;flex-direction:column}.brand{display:flex;align-items:center;gap:11px;padding:0 10px 48px}.brand-mark{display:grid;place-items:center;background:#e6b86a;color:#153e3b;font-family:'Space Grotesk';font-size:23px;font-weight:700;width:38px;height:38px;border-radius:11px}.brand strong{display:block;color:white;font-family:'Space Grotesk';font-size:19px}.brand small{display:block;color:#a9c8c0;font-size:10px;margin-top:3px}.nav-item{width:100%;padding:13px 14px;margin:3px 0;background:transparent;color:#a9c8c0;text-align:left;border-radius:10px;display:flex;gap:13px;align-items:center;font-weight:600}.nav-item span{width:18px;text-align:center;font-size:18px}.nav-item:hover,.nav-item.active{background:#21615c;color:#fff}.sidebar-foot{margin-top:auto;border-top:1px solid #2b625d;padding:18px 10px 0;color:#a9c8c0;font-size:12px}.sidebar-foot small{display:block;color:#7fa69e;margin-top:8px}.status-dot{display:inline-block;width:7px;height:7px;background:#83d79b;border-radius:50%;margin-right:6px}.main-content{flex:1;min-width:0}.topbar{height:118px;padding:34px 44px 24px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,.54)}.eyebrow{text-transform:uppercase;letter-spacing:1.5px;color:var(--orange);font-weight:700;font-size:10px;margin:0 0 7px}.topbar h1{font:600 28px 'Space Grotesk';margin:0;letter-spacing:0}.top-actions{display:flex;gap:16px;align-items:center}.today{font-size:13px;col